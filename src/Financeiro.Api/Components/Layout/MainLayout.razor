@inherits LayoutComponentBase
@rendermode InteractiveServer
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="topbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="AlternarMenu"
                       aria-label="Abrir menu" />
        <MudText Typo="Typo.h6" Class="brand">Financeiro pessoal</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_menuAberto" Elevation="0" ClipMode="DrawerClipMode.Always"
               Variant="@DrawerVariant.Responsive" Class="navigation-drawer">
        <MudNavMenu>
            <MudText Typo="Typo.caption" Class="nav-section">Relatórios</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance">
                Por conta
            </MudNavLink>
            <MudNavLink Href="/relatorios/composicao" Icon="@Icons.Material.Filled.DonutLarge">
                Composição
            </MudNavLink>
            <MudNavLink Href="/relatorios/fluxo-caixa" Icon="@Icons.Material.Filled.Timeline">
                Fluxo de caixa
            </MudNavLink>
            <MudNavLink Href="/relatorios/comparacao" Icon="@Icons.Material.Filled.CompareArrows">
                Comparação
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAberto = true;

    private void AlternarMenu() => _menuAberto = !_menuAberto;
}